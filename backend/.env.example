# ===== Cấu hình Backend (sao chép file này thành .env và điền giá trị thật) =====
# Cổng chạy server
PORT=5000

# MongoDB connection string (không commit giá trị thật)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vet_clinic

# JWT secret - dùng chuỗi dài, ngẫu nhiên
JWT_SECRET=thay_bang_chuoi_random_dai_64_ky_tu

# Google OAuth Client ID (public, dùng để đăng nhập Google)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ===== Gemini / AI Studio =====
# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Model Gemini dùng cho chatbot (mặc định: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
