# =========================================================
# KT CLINIC — Cấu hình Backend
# Sao chép file này thành .env và điền giá trị thật vào
# TUYỆT ĐỐI không commit file .env lên Git!
# =========================================================

# Cổng chạy server
PORT=5000

# Môi trường (development | production)
NODE_ENV=development

# ===== MongoDB Atlas =====
# Lấy tại: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vet_clinic

# ===== JWT Secret =====
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=thay_bang_chuoi_random_dai_64_ky_tu

# ===== Google OAuth =====
# Lấy tại: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ===== Gemini AI =====
# Lấy tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-flash-latest

# ===== Gmail SMTP (cho OTP quên mật khẩu) =====
# Gmail → Cài đặt → Bảo mật → Mật khẩu ứng dụng → Tạo mới (16 ký tự)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ===== VNPay Sandbox =====
# Đăng ký tại: https://sandbox.vnpayment.vn/devreg
VNP_TMN_CODE=your_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment-return

# ===== VietQR / Casso Webhook Security =====
# Lấy Secure Token tại: casso.vn → Cài đặt → API → Secure Token
# Điền token này vào cấu hình webhook trên casso.vn
CASSO_SECURE_TOKEN=your_casso_secure_token_here

# ===== Thông tin ngân hàng (hiển thị QR) =====
BANK_ID=VCB
BANK_ACCOUNT=your_bank_account_number
BANK_NAME=TEN_TAI_KHOAN_NGAN_HANG

# ===== Tài khoản Admin mặc định =====
# Đổi mật khẩu ngay sau lần đăng nhập đầu tiên!
ADMIN_PASSWORD=change_me_immediately_123!
